# ============================================================
# 环境变量样例（.env.example）
# ------------------------------------------------------------
# 这个文件的作用：告诉「别人（或半年后的你）」这个项目需要哪些环境变量、各自干什么用。
#
# 使用方式：需要本地跑的时候，复制本文件为 .env，再把值填进去。
#   .env 已被 .gitignore 忽略（.gitignore 第 2 行）—— 永远不会被提交。
#
# ⚠️ 铁律：本文件只放「变量名 + 说明 + 占位符」，**永远不放真实值**。
# ⚠️ 本项目没有引入 dotenv 之类的加载库，所以：
#   · 云函数（cloudbase/functions/*）的环境变量 → 在 CloudBase 控制台 / CLI 里配置
#   · 本机跑测试 → 临时注入即可（Windows: set X=Y ｜ macOS/Linux: export X=Y）
# ============================================================

# —— 云函数监听端口（Web 函数约定 9000；本地直连自测可改）——
PORT=9000

# —— CloudBase 环境 ID ——（公开标识符，不是密钥；本项目的真实值见 cloudbase/README.md，浏览器 F12 也看得到）
TCB_ENV_ID=yishou-<环境ID>

# —— CloudBase 环境 API Key ——（★ 这是真密钥，只放服务端）
# 获取方式：tcb env apikey create <名字> -e <环境ID> --type api_key --json
# 放哪：云函数「环境变量」里（控制台 → 函数配置 → 环境变量）
# 绝不能放：前端代码、仓库、被提交的任何文件、聊天记录
TCB_API_KEY=<在控制台或 CLI 生成的 ApiKey>

# —— 可选：PostgreSQL 直连串。配了就直连 TCP，不配就走 CloudBase HTTP 网关 ——
# 形态：postgresql://<用户名>:<密码>@<主机>:5432/<库名>
# ⚠️ 这一串里含密码，属机密：只填在云函数环境变量里
PG_URL=

# —— 可选：走 PG_URL 直连时是否要求 SSL（填 1 = 要求）——
PG_SSL=

# —— 只在本机跑 cloudbase/tests/online-regress.js（线上回归）时用：线上接口基址 ——
# 形态：https://<环境ID>-<appid>.ap-shanghai.app.tcloudbase.com
API_BASE=
